### 2c. Activity Diagram — Kuis & Sertifikat

```plantuml
@startuml
skinparam ActivityBackgroundColor #f9f7f4
skinparam ActivityBorderColor #3E352B
skinparam ArrowColor #4a5942

start

:Pengguna membuka /kuis;
:ZoologyQuiz: gameState = 'welcome';
:GSAP animasi elemen .content-anim (opacity, y);

:Pengguna klik "Mulai Kuis";
:gameState = 'chapters';
:QUIZ_CATEGORIES ditampilkan + opsi "Seluruh Area";

if (Pengguna pilih "Seluruh Area"?) then (Ya)
  :selectedCategory = null;
  :filteredQuestions = 10 soal acak dari semua kategori;
else (Tidak, pilih kategori spesifik)
  :selectedCategory = QuizCategory yang dipilih;
  :filteredQuestions = soal dengan categoryId yang cocok;
end if

:gameState = 'playing';
:currentQuestionIndex = 0, score = 0;

repeat
  :Soal ke-(currentQuestionIndex+1) ditampilkan;
  :Progress bar diperbarui;
  :4 opsi jawaban ditampilkan dalam grid;

  :Pengguna memilih salah satu opsi;
  :selectedOption diset;

  if (opsi === correctAnswer?) then (Ya)
    :isCorrect = true;
    :score + 1;
    :Opsi berubah hijau + ikon Check;
  else (Tidak)
    :isCorrect = false;
    :Opsi yang dipilih merah + ikon X;
    :correctAnswer ditampilkan dengan highlight hijau;
  end if

  :setTimeout 400ms;
  :showFact = true;
  :GSAP: feedbackRef animate (opacity, scale, y);
  :Panel "Tahukah Kamu?" muncul dengan teks fact;

  :Pengguna klik "Soal Berikutnya" / "Selesaikan Misi";
  :showFact = false;
  :GSAP: questionRef slide-out ke kiri;
  :currentQuestionIndex + 1;
  :GSAP: questionRef slide-in dari kanan;

repeat while (currentQuestionIndex < filteredQuestions.length - 1) is (Ya)

:gameState = 'result';
:Tampilan "Misi Selesai!" dengan skor;

:Pengguna mengisi nama di input form;
:Form onSubmit → playerName diset;

:Sertifikat dirender (div#certificateRef, 800x800px);
:Sertifikat menampilkan:\n- Nama pemain\n- Skor (score/total)\n- Predikat (Legendary/Expert/Apprentice Scholar)\n- Tanggal terbit\n- Stempel MZB;

:certScale dihitung berdasarkan window.innerWidth;

if (Pengguna klik "Unduh Gambar (PNG)"?) then (Ya)
  :html2canvas(certificateRef, scale=2);
  :Canvas dikonversi ke dataURL PNG;
  :File diunduh dengan nama Sertifikat-MZB-[nama].png;
end if

if (Pengguna klik "Mulai Misi Baru"?) then (Ya)
  :playerName = '';
  :gameState = 'chapters';
end if

stop
@enduml
```

